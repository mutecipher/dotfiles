config/nvim/lazy-lock.json

# pi — only agent/settings.json is managed. Everything else under ~/.pi/agent
# (which lands here via the ~/.pi symlink) is state, secret, or plugin-owned:
# auth.json (API keys), mcp-oauth/ (OAuth tokens), git/ (package clones),
# sessions/, goals/, logs/, models-store.json, trust.json, etc.
config/pi/agent/*
!config/pi/agent/settings.json
!config/pi/agent/AGENTS.md

# herdr — only config.toml is managed; runtime state must never be committed.
config/herdr/session.json
config/herdr/release-notes.json
config/herdr/*.log
config/herdr/*.sock
config/herdr/.plugins.lock
