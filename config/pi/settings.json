{
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-v4-pro",
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": true,
  "showCacheMissNotices": false,
  "theme": "light/dark",
  "quietStartup": false,
  "defaultProjectTrust": "ask",
  "collapseChangelog": true,
  "enableInstallTelemetry": false,
  "enableAnalytics": false,
  "doubleEscapeAction": "tree",
  "treeFilterMode": "default",
  "editorPaddingX": 0,
  "outputPad": 1,
  "autocompleteMaxVisible": 5,
  "showHardwareCursor": false,
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "transcript",
  "fullscreenScrollbar": "auto",
  "fullscreenCopyOnSelect": true,
  "steeringMode": "one-at-a-time",
  "followUpMode": "one-at-a-time",
  "transport": "auto",
  "httpIdleTimeoutMs": 300000,
  "websocketConnectTimeoutMs": 15000,
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "branchSummary": {
    "reserveTokens": 16384,
    "skipPrompt": false
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  },
  "warnings": {
    "anthropicExtraUsage": true
  },
  "terminal": {
    "showImages": false,
    "imageWidthCells": 60,
    "clearOnShrink": false,
    "showTerminalProgress": true,
    "hyperlinks": "auto",
    "images": "auto",
    "trueColor": "auto"
  },
  "images": {
    "autoResize": true,
    "blockImages": false
  },
  "markdown": {
    "codeBlockIndent": "  ",
    "mermaid": "streaming"
  },
  "packages": [
    "git:github.com/mutecipher/pi-goal",
    "git:github.com/mutecipher/pi-mcp",
    "git:github.com/mutecipher/pi-model-router",
    "git:github.com/mutecipher/pi-subagent",
    "git:github.com/mutecipher/pi-web-tools",
    "git:github.com:mutecipher/pi-todo",
    "git:github.com/mutecipher/pi-ask-question"
  ],
  "extensions": [],
  "skills": [],
  "prompts": [],
  "themes": [],
  "enableSkillCommands": true
}
