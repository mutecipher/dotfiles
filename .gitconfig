[user]
  name = Cory Hutchison
  email = cory@mutecipher.com
  username = mutecipher
  signingkey = 32ABE5D29C8EE52D273ACB98705B2FEF0EF41082

[commit]
  gpgsign = true

[pull]
  rebase = true

[push]
  autoSetupRemote = true

[init]
  defaultBranch = main

[gpg]
  program = /opt/homebrew/bin/gpg

[include]
  path = ~/.gitconfig.overrides

[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
